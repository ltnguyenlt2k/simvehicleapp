#!/usr/bin/env bash
# SimVehicleApp dev helper (dev phase: one folder per module, aggregated by docker-compose.yml)
#   scripts/sv init             create .env from .env.example with fresh secrets (also done by build/up)
#   scripts/sv build            build all images in dependency order
#   scripts/sv up               start everything (runtime + toolchain + ide + studio)
#   scripts/sv down [-v]        stop (−v also removes volumes)
#   scripts/sv refresh [--latest]  update the running stack to the pushed HEAD (studio image from CI, keeps data)
#   scripts/sv smoke            S-1/S-2 smoke: new project offline build + run app + MQTT check
#   scripts/sv smoke live       full live smoke: M7 SynCode gate + M8 GW-A live gate (scripts/smoke.sh)
#   scripts/sv reset-caches     drop conan/velocitas volumes after rebuilding the toolchain image
#   scripts/sv demo-video       record the full-flow demo (Playwright + ffmpeg) into docs/media/full-flow.{mp4,gif}
set -euo pipefail
cd "$(dirname "$0")/.."
DC="docker compose"
# Version info of every service (/version, System status): the checked-out commit.
export SV_COMMIT="${SV_COMMIT:-$(git rev-parse HEAD 2>/dev/null || echo unknown)}"
# .env from .env.example on a clean checkout, with random secrets for the keys compose requires.
ensure_env() {
  [[ -f .env ]] || { cp .env.example .env; echo "sv: created .env from .env.example"; }
  local k
  for k in BETTER_AUTH_SECRET ENCRYPTION_KEY API_ENCRYPTION_KEY INTERNAL_API_SECRET; do
    if ! grep -qE "^$k=.+" .env; then
      sed -i "/^$k=\$/d" .env
      echo "$k=$(python3 -c 'import secrets; print(secrets.token_hex(32))')" >> .env
      echo "sv: generated $k in .env"
    fi
  done
}
case "${1:-}" in
  init) ensure_env ;;
  build)
    ensure_env
    $DC build contracts                           # build-only image consumed by core, toolchain agent, services
    $DC build devcontainer-cpp toolchain-cpp      # base layers next (ide FROMs the toolchain image)
    # Python backend (profile `python` in COMPOSE_PROFILES, ADR-0040): its toolchain before ide-python.
    if $DC config --services | grep -qx toolchain-python; then $DC build devcontainer-python toolchain-python; fi
    # Rust (profile `rust`, ADR-0041): the toolchain seeds its runtime crate from the codegen-rust image.
    if $DC config --services | grep -qx toolchain-rust; then $DC build codegen-rust toolchain-rust; fi
    $DC build ;;
  up)    ensure_env
         # Toolchains first: they seed the Velocitas/Conan volumes the IDEs share (two containers creating a
         # new volume at once race on the copy-up).
         if [[ $# -eq 1 ]]; then $DC up -d $($DC config --services | grep -x 'toolchain-[a-z]*' | tr '\n' ' '); fi
         $DC up -d "${@:2}" ;;
  down)  $DC down "${@:2}" ;;
  reset-caches) $DC down; docker volume rm -f simvehicleapp_sv-conan2 simvehicleapp_sv-velocitas simvehicleapp_sv-ccache simvehicleapp_sv-velocitas-python ;;
  smoke) if [[ "${2:-}" == live ]]; then exec scripts/smoke.sh; else exec spikes/smoke.sh; fi ;;
  refresh) exec scripts/sv-refresh.sh "${@:2}" ;;
  demo-video) exec scripts/demo-video.sh "${@:2}" ;;
  *) sed -n '2,12p' "$0"; exit 1 ;;
esac
