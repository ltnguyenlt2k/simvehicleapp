{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simvehicleapp:contracts:diagnostics-catalog:1.0.0-alpha.1",
  "title": "Diagnostics catalog v1",
  "description": "Catalog of public diagnostic codes (ADR-0016 §2). Codes are append-only; retire with `deprecated`.",
  "type": "object",
  "required": ["catalogVersion", "codes"],
  "additionalProperties": false,
  "properties": {
    "catalogVersion": { "$ref": "urn:simvehicleapp:contracts:common:1.0.0-alpha.1#/$defs/semver" },
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "severity", "stage", "title", "since"],
        "additionalProperties": false,
        "properties": {
          "code": { "$ref": "urn:simvehicleapp:contracts:diagnostics:1.0.0-alpha.1#/$defs/code" },
          "severity": { "$ref": "urn:simvehicleapp:contracts:diagnostics:1.0.0-alpha.1#/$defs/severity" },
          "stage": { "$ref": "urn:simvehicleapp:contracts:diagnostics:1.0.0-alpha.1#/$defs/stage" },
          "title": { "type": "string", "minLength": 1 },
          "since": { "$ref": "urn:simvehicleapp:contracts:common:1.0.0-alpha.1#/$defs/semver" },
          "deprecated": { "type": "boolean" },
          "adr": { "type": "string", "pattern": "^ADR-[0-9]{4}$" }
        }
      }
    }
  }
}
