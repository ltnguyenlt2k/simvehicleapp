{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simvehicleapp:contracts:signal-update:1.0.0-alpha.1",
  "title": "SignalUpdate v1",
  "description": "Server→client message of the signal-gateway WebSocket (analysis/08 §4, ADR-0024). Client messages: `#/$defs/clientMessage`.",
  "type": "object",
  "required": ["path", "ts", "value", "field"],
  "additionalProperties": false,
  "properties": {
    "path": { "$ref": "urn:simvehicleapp:contracts:common:1.0.0-alpha.1#/$defs/vssPath" },
    "ts": { "$ref": "urn:simvehicleapp:contracts:common:1.0.0-alpha.1#/$defs/epochMs" },
    "value": { "$ref": "urn:simvehicleapp:contracts:common:1.0.0-alpha.1#/$defs/jsonValue" },
    "field": { "$ref": "#/$defs/field" },
    "source": {
      "enum": ["inject", "playback", "mirror", "app", "vehicle"],
      "description": "Who made this change (ADR-0062 §3): `inject` the user (POST /signals), `playback` a test playback, `mirror` the gateway copying an actuator's target to its current value, `app` the vehicle app (an actuator's target, or the current value of an actuator the gateway provides for a kuksa.val.v2 app), `vehicle` anything else (feeders, the car of a deployment). Absent on the current values sent first."
    }
  },
  "$defs": {
    "field": { "enum": ["value", "target"], "description": "`value` = current value, `target` = actuator target (kuksa.val.v1)." },
    "clientMessage": {
      "title": "SignalClientMessage",
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "paths"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "subscribe" },
            "paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "urn:simvehicleapp:contracts:common:1.0.0-alpha.1#/$defs/vssPath" }
            }
          }
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "unsubscribe" },
            "paths": {
              "type": "array",
              "items": { "$ref": "urn:simvehicleapp:contracts:common:1.0.0-alpha.1#/$defs/vssPath" }
            }
          }
        },
        {
          "type": "object",
          "required": ["op", "path", "value", "field"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "set" },
            "path": { "$ref": "urn:simvehicleapp:contracts:common:1.0.0-alpha.1#/$defs/vssPath" },
            "value": { "$ref": "urn:simvehicleapp:contracts:common:1.0.0-alpha.1#/$defs/jsonValue" },
            "field": { "$ref": "#/$defs/field" }
          }
        }
      ]
    }
  }
}
