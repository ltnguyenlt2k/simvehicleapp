{
  "name": "@simvehicleapp/contracts",
  "version": "1.0.0-alpha.1",
  "description": "SimVehicleApp contracts: JSON Schemas, generated TypeScript types, validators and shared fixtures (ADR-0007).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "packages/ts/src/index.ts",
  "types": "packages/ts/src/index.ts",
  "exports": {
    ".": "./packages/ts/src/index.ts",
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*",
    "./openapi/*": "./openapi/*"
  },
  "files": [
    "schemas",
    "openapi",
    "fixtures",
    "packages/ts/src",
    "!packages/ts/src/**/*.test.ts",
    "NOTICE"
  ],
  "scripts": {
    "gen": "bun tools/gen-types.ts && bun tools/gen-diagnostics-doc.ts",
    "check": "bun tools/gen-types.ts --check && bun tools/gen-diagnostics-doc.ts --check && tsc --noEmit -p .",
    "test": "bun test"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3",
    "@types/bun": "1.3.8"
  }
}
