{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": { "@simvehicleapp/contracts": ["./packages/ts/src/index.ts"] }
  },
  "include": ["packages/ts/src/**/*.ts", "packages/service-kit/src/**/*.ts", "tools/**/*.ts"]
}
