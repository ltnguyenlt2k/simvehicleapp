{
  "graphVersion": "1.0.0",
  "workflowId": "c45_grip",
  "revision": 1,
  "name": "Low grip limit",
  "vss": {
    "release": "v4.0"
  },
  "variables": [],
  "blocks": [
    {
      "id": "b1",
      "type": "sv_on_signal_changed",
      "name": "friction",
      "props": {
        "path": "Vehicle.ADAS.ESC.RoadFriction.MostProbable",
        "mode": "any",
        "debounceMs": 0,
        "concurrency": "queue"
      },
      "parentId": null,
      "blockVersion": 1
    },
    {
      "id": "b2",
      "type": "sv_filter",
      "name": "avg",
      "props": {
        "value": "<friction.value>",
        "mode": "moving-average",
        "window": 3
      },
      "parentId": null,
      "blockVersion": 1
    },
    {
      "id": "b3",
      "type": "sv_if",
      "name": "lowGrip",
      "props": {
        "condition": "<avg.value> < 30 && <Vehicle.Speed> > 50"
      },
      "parentId": null,
      "blockVersion": 1
    },
    {
      "id": "b4",
      "type": "sv_set_actuator",
      "name": "limit",
      "props": {
        "path": "Vehicle.ADAS.CruiseControl.SpeedSet",
        "value": "clamp(<Vehicle.Speed> - 20, 30, 50)",
        "awaitAck": true,
        "onError": "continue"
      },
      "parentId": null,
      "blockVersion": 1
    },
    {
      "id": "b5",
      "type": "sv_hmi_notify",
      "name": "warn",
      "props": {
        "severity": "warning",
        "title": "Low grip",
        "message": "Friction <avg.value> %, cruise limited"
      },
      "parentId": null,
      "blockVersion": 1
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "b1",
      "fromHandle": "source",
      "to": "b2",
      "toHandle": "target"
    },
    {
      "id": "e2",
      "from": "b2",
      "fromHandle": "source",
      "to": "b3",
      "toHandle": "target"
    },
    {
      "id": "e3",
      "from": "b3",
      "fromHandle": "then",
      "to": "b4",
      "toHandle": "target"
    },
    {
      "id": "e4",
      "from": "b4",
      "fromHandle": "source",
      "to": "b5",
      "toHandle": "target"
    }
  ]
}
