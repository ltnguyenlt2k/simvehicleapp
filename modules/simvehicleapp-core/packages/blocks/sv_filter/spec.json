{
  "specVersion": "1.0.0",
  "type": "sv_filter",
  "version": 1,
  "category": "state",
  "title": "Filter",
  "priority": "P2",
  "opcode": "state.filter",
  "props": [
    { "name": "value", "kind": "expression", "required": true },
    { "name": "mode", "kind": "enum", "required": false, "default": "moving-average", "enum": ["moving-average", "exponential", "median"] },
    { "name": "window", "kind": "integer", "required": false, "default": 5, "min": 1, "max": 1000 },
    { "name": "alpha", "kind": "number", "required": false, "default": 0.5, "min": 0, "max": 1 }
  ],
  "outputs": [
    { "name": "value", "type": "double" },
    { "name": "samples", "type": "uint32" }
  ],
  "handles": { "in": ["target"], "out": ["source", "error"] }
}
