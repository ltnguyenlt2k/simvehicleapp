    {
      "id": "rf.follow_route",
      "category": "navigation",
      "title": {
        "vi": "Đi theo tuyến",
        "en": "Follow route"
      },
      "description": {
        "vi": "Đi qua các điểm theo thứ tự (tối đa theo profile).",
