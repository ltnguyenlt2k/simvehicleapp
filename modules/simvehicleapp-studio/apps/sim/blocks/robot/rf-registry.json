      "props": [],
      "outputs": ["ok", "failed"],
      "command": "Robot.Safety.ResetStop"
    },
    {
      "id": "rf.move",
      "category": "motion",
      "title": {
        "vi": "Di chuyển",
        "en": "Move"
      },
      "description": {
        "vi": "Gửi vận tốc 20 Hz trong thời gian đặt; luôn trả về 0 khi kết thúc.",
        "en": "Sends velocity at 20 Hz for the duration; always returns to zero."
      },
      "props": [
        {
          "name": "linear",
          "type": "number",
          "unit": "m/s",
          "required": true,
          "default": 0.2,
          "signal": "Robot.Motion.Velocity.LinearX",
          "title": {
            "vi": "Tốc độ tiến (m/s)",
            "en": "Forward speed (m/s)"
          },
          "min": -0.5,
          "max": 0.5
        },
        {
          "name": "angular",
          "type": "number",
          "unit": "rad/s",
          "required": true,
          "default": 0,
          "signal": "Robot.Motion.Velocity.AngularZ",
          "title": {
            "vi": "Tốc độ quay (rad/s)",
            "en": "Turn rate (rad/s)"
          },
          "min": -0.65,
          "max": 0.65
        },
        {
          "name": "durationMs",
          "type": "duration",
          "required": true,
          "default": 1000,
          "min": 50,
          "max": 30000,
          "title": {
            "vi": "Thời gian (ms)",
            "en": "Duration (ms)"
          }
        }
      ],
      "outputs": ["ok", "failed"],
      "setpoint": "Robot.Motion.Velocity"
    },
    {
      "id": "rf.perform",
      "category": "motion",
      "title": {
        "vi": "Thực hiện động tác",
        "en": "Perform motion"
      },
      "description": {
        "vi": "Động tác đã kiểm định; thành công chỉ khi robot báo kết quả vật lý.",
        "en": "Qualified motion; success only from the measured physical result."
      },
      "props": [
        {
          "name": "name",
          "type": "enum",
          "required": true,
          "default": "BOW",
          "title": {
            "vi": "Động tác",
            "en": "Motion"
          },
          "values": [
            "CROUCH",
            "BOW",
            "TILT",
            "LIFT_FRONT_LEFT",
            "JUMP",
            "WAVE_FRONT_LEFT",
            "SIT",
            "STAND"
          ]
        }
      ],
      "outputs": ["ok", "failed"],
      "command": "Robot.Motion.Perform",
      "pending": "dog R4 W2: WAVE_FRONT_LEFT, SIT, STAND not yet in the dog (CROUCH, BOW, TILT, LIFT_FRONT_LEFT, JUMP available)"
    },
    {
      "id": "rf.go_to",
      "category": "navigation",
      "title": {
        "vi": "Đi tới điểm",
        "en": "Go to"
      },
      "description": {
        "vi": "Điều hướng tới (X, Y) trong khung map bằng Nav2 của robot.",
