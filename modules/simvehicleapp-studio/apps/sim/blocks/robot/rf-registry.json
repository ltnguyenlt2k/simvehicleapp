      },
      "props": [
        {
          "name": "x",
          "type": "number",
          "unit": "m",
          "required": true,
          "default": 1.0,
          "title": {
            "vi": "X (m)",
            "en": "X (m)"
          }
        },
        {
          "name": "y",
          "type": "number",
          "unit": "m",
          "required": true,
          "default": 0.0,
          "title": {
            "vi": "Y (m)",
            "en": "Y (m)"
          }
        }
      ],
      "outputs": ["ok", "failed"],
      "command": "Robot.Navigation.GoTo"
