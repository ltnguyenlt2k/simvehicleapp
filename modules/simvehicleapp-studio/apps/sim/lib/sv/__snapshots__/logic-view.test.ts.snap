// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`logic view (M18-T07, ADR-0059 §2) > GW-A reads as sentences, the same every time 1`] = `
"When Speed changes:
  If speedchanged.value > 120 holds for 2 s
    stable ⇒
      Set Hazard.IsSignaling = true, wait for it
      ⚠ HMI: Overspeed

When Speed goes below 110:
  Set Hazard.IsSignaling = false, wait for it"
`;

exports[`logic view (M18-T07, ADR-0059 §2) > GW-B reads as sentences, the same every time 1`] = `
"When StateOfCharge.Current changes:
  If socchanged.value < 20 && IsMoving
    then ⇒
      ⚠ HMI: Low battery
      Set InteractiveLightBar.Color = "RED", wait for it"
`;

exports[`logic view (M18-T07, ADR-0059 §2) > GW-C reads as sentences, the same every time 1`] = `
"When Raindetection.Intensity changes (settled 500 ms):
  = rainchanged.value < 10 ? "OFF" : rainch…
  Set Wiping.Mode = wipermode.result, wait for it"
`;

exports[`logic view (M18-T07, ADR-0059 §2) > GW-D reads as sentences, the same every time 1`] = `
"When Speed goes above 15:
  Set DriverSide.IsLocked = true, wait for it
  Set PassengerSide.IsLocked = true, wait for it
  Set DriverSide.IsLocked = true, wait for it
  Set PassengerSide.IsLocked = true, wait for it"
`;

exports[`logic view (M18-T07, ADR-0059 §2) > GW-E reads as sentences, the same every time 1`] = `
"Every 1 s, first after 1 s:
  Publish to simvehicleapp/telemetry"
`;

exports[`logic view (M18-T07, ADR-0059 §2) > GW-F reads as sentences, the same every time 1`] = `
"When the app starts:
  Run in parallel, continue when all finish (Welcome)
    Set DriverSide.IsLightOn = true, wait for it
    Wait 500 ms
    Set DriverSide.Intensity = 80, wait for it
  Log info: welcome done"
`;

exports[`logic view (M18-T07, ADR-0059 §2) > GW-G reads as sentences, the same every time 1`] = `
"When Raindetection.Intensity > 30 && Speed <… becomes true:
  Set Window.Position = 0, wait for it
  Set Window.Position = 0, wait for it
  Set Window.Position = 0, wait for it
  Set Window.Position = 0, wait for it
  Wait until Window.Position == 0 && Window.Position… (max 10 s)
    in time ⇒
      Log info: windows closed
    timeout ⇒
      Log warn: windows did not close"
`;
