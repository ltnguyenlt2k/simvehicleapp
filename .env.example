# SimVehicleApp dev stack — copy to .env and adjust. (.env is git-ignored)
SV_IDE_PORT=8080
SV_IDE_PASSWORD=simvehicleapp
SV_DATABROKER_PORT=55555
SV_MQTT_PORT=1883
SV_MQTT_WS_PORT=9001
SV_CONAN_JOBS=8
# Low-spec hosts (docs/DEPLOY.md, ADR-0051): parallel compile jobs of the generated C++ app build (empty = Ninja
# default, CPUs + 2; 2 keeps the build under ~1 GB). SV_CARGO_JOBS (default 2) does the same for Rust.
#SV_BUILD_JOBS=2
# Set by `scripts/sv pull <tag>` (prebuilt release images): `scripts/sv up` then never builds on this host.
#SV_PREBUILT=
# Host capacity (ADR-0053, docs/DEPLOY.md "Dung lượng & quota"): free-disk thresholds of the projects volume —
# below LOW the studio warns, below HIGH no new vehicle app, below FLOOD no SynCode — and shared-cache caps.
#SV_DISK_LOW_GB=10
#SV_DISK_HIGH_GB=5
#SV_DISK_FLOOD_GB=2
#SV_KEEP_GENERATIONS=10
# App quota (host; the studio also limits apps per workspace: SV_MAX_APPS_PER_WORKSPACE), workflows per app,
# SynCode queue, and the sweeper: clean builds of apps idle N days, delete failed apps after N days (0 = never).
#SV_MAX_APPS_TOTAL=100
#SV_MAX_APPS_PER_WORKSPACE=10
#SV_MAX_WORKFLOWS_PER_APP=20
#SV_MAX_QUEUED_GENERATIONS=20
#SV_IDLE_CLEAN_DAYS=14
#SV_FAILED_TTL_DAYS=7
#SV_SWEEP_INTERVAL_MIN=60
# Runs (ADR-0057): 1 = every run gets a databroker of its own (several users/apps at once), within quotas per user
# and host and a time limit in minutes (0 = none) that Extend prolongs; 0 = one run at a time on the shared stack.
#SV_RUN_SANDBOX=0
#SV_MAX_RUNS_PER_USER=2
#SV_MAX_RUNS_TOTAL=20
#SV_RUN_MAX_MINUTES=30
#SV_RUN_MAX_EXTENSIONS=3
# Databroker API of each backend's apps (ADR-0047): every backend runs on kuksa.val.v2 (the signal-gateway provides
# the actuators the app writes). Back to the old API: *=sdv.databroker.v1, or per backend: cpp=sdv.databroker.v1.
#SV_DATABROKER_API=
#SV_CCACHE_MAX=2G
# Custom VSS models vX.Y-<name> (ADR-0052, docs/user-guide/custom-vss.md): `scripts/sv vss use <release>` sets these.
#   COMPOSE_PROFILES gets `vss-custom`; SV_DATABROKERS gets <release>=databroker-custom:55555.
#SV_VSS_CUSTOM_FILE=v4.0-acme/vss_rel_4.0-acme.json

# Python backend (ADR-0040, M12) — opt-in. Uncomment the lines below: the `python` profile starts codegen-python,
# toolchain-python and ide-python; the compiler/orchestrator/workspace find them through SV_BACKENDS/SV_TOOLCHAINS.
#COMPOSE_PROFILES=python
#SV_BACKENDS=cpp=http://codegen-cpp:4110,python=http://codegen-python:4120
#SV_TOOLCHAINS=cpp=http://toolchain-cpp:4210,python=http://toolchain-python:4220
# Rust backend (ADR-0041, experimental — not Velocitas tooling): add `rust` to COMPOSE_PROFILES (e.g. python,rust) and
#   rust=http://codegen-rust:4130 to SV_BACKENDS, rust=http://toolchain-rust:4230 to SV_TOOLCHAINS. No IDE for Rust yet.
# Editor links per language (ide-python on SV_IDE_PYTHON_PORT, default 8081):
#SV_IDE_PUBLIC_URL=cpp=http://127.0.0.1:8080,python=http://127.0.0.1:8081

# Studio public URL. Open the studio with EXACTLY this origin: Better Auth rejects sign-in/sign-up from any other
# (http://127.0.0.1:3000 and http://localhost:3000 are different origins → "Invalid origin").
SV_STUDIO_URL=http://localhost:3000
# Host port of the studio (keep SV_STUDIO_URL on the same port), e.g. 3100 when 3000 is taken.
#SV_STUDIO_PORT=3000
# Realtime (canvas collaboration) URL as seen by the browser; must match the published realtime port.
SV_REALTIME_URL=http://localhost:3002

# AI Assistant (ADR-0030): provider + model; keys stay in the ai-assistant container (never in the browser).
#   SV_AI_PROVIDER = anthropic | openai | openai-compatible | ollama | gemini | fake
#   fake: simulated assistant (no model, no network, little RAM) — understands a few request shapes, for demos/E2E
#   ollama: a local Ollama (default http://host.docker.internal:11434/v1), e.g. SV_AI_MODEL=qwen3.5:9b
SV_AI_PROVIDER=
SV_AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# OpenAI-compatible server (OpenRouter, Azure, LiteLLM, vLLM…): base URL + optional key
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# MCP server /mcp on 127.0.0.1:4300 for external agents: a bearer token (>= 16 chars) enables it
SV_MCP_TOKEN=
# External MCP servers the assistant may use: JSON [{"name":"x","url":"http://…/mcp","token":"…","safeTools":[]}]
SV_MCP_CLIENTS=
