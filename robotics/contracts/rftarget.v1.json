{
  "$id": "urn:robotflow:rftarget.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalogHash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "context": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sourceEpoch"
                  ]
                },
                {
                  "required": [
                    "brainBootId"
                  ]
                },
                {
                  "required": [
                    "sceneEpoch"
                  ]
                },
                {
                  "required": [
                    "configHash"
                  ]
                },
                {
                  "required": [
                    "sceneId"
                  ]
                },
                {
                  "required": [
                    "mapGeneration"
                  ]
                }
              ]
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "ROS_SIM"
              }
            }
          },
          "then": {
            "required": [
              "sourceEpoch",
              "brainBootId",
              "sceneEpoch",
              "configHash",
              "sceneId",
              "mapGeneration"
            ]
          }
        }
      ],
      "properties": {
        "adapterSourceHash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "brainBootId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "configHash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "KINEMATIC_MOCK",
            "ROS_SIM"
          ]
        },
        "mapGeneration": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "mappingHash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "remoteArmAuthorized": {
          "type": "boolean"
        },
        "sceneEpoch": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "sceneId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "sourceEpoch": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "mappingHash",
        "adapterSourceHash"
      ],
      "type": "object"
    },
    "profileId": {
      "pattern": "^[a-z][a-z0-9-]{0,95}$",
      "type": "string"
    },
    "robotId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "rftarget.v1"
    }
  },
  "required": [
    "schema",
    "robotId",
    "profileId",
    "catalogHash",
    "context"
  ],
  "type": "object"
}
