{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simvehicleapp.local/contracts/studio/rfproject.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "revision",
    "updatedAt",
    "workflow"
  ],
  "properties": {
    "schema": {
      "const": "rfproject.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "workflow": {
      "type": "object"
    }
  }
}
