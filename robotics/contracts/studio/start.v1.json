{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simvehicleapp.local/contracts/studio/rfstart.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "deploymentId",
    "createdAt"
  ],
  "properties": {
    "schema": {
      "const": "rfstart.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "deploymentId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    }
  }
}
