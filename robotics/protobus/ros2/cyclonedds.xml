<!-- Protobus ROS 2 bridge: unicast discovery of the dog services (peers by service name), as qualified by M22 S-R1. -->
<CycloneDDS>
  <Domain>
    <General>
      <Interfaces><NetworkInterface name="eth0" /></Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>64</MaxAutoParticipantIndex>
      <Peers>
        <Peer Address="sim" /><Peer Address="brain" /><Peer Address="render" /><Peer Address="perception" />
        <Peer Address="slam" /><Peer Address="nav2" /><Peer Address="gateway" />
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
